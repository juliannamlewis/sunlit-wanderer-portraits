---
import { site } from '../lib/content';

const socialLinks = [
  { key: 'facebook', label: 'Facebook', url: site.social.facebook },
  { key: 'instagram', label: 'Instagram', url: site.social.instagram },
  { key: 'tiktok', label: 'TikTok', url: site.social.tiktok },
  { key: 'pinterest', label: 'Pinterest', url: site.social.pinterest },
].filter((s) => s.url);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-block">
      <p class="footer-wordmark">{site.site.name}</p>
      <p class="footer-tagline">{site.site.tagline}</p>
    </div>

    <div class="footer-block">
      <span class="eyebrow">Get in touch</span>
      <a class="footer-messenger" href={site.contact.messenger} target="_blank" rel="noopener">
        {site.contact.messengerLabel}
      </a>
      <a class="footer-phone" href={site.contact.phoneTel}>{site.contact.phoneDisplay}</a>
    </div>

    {socialLinks.length > 0 && (
      <div class="footer-block">
        <span class="eyebrow">Follow along</span>
        <ul class="social-list">
          {socialLinks.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="footer-block">
      <span class="eyebrow">Wall art</span>
      <a href={site.shop.url} target="_blank" rel="noopener">{site.shop.label}</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} {site.site.name}. {site.site.serviceArea}.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
    padding-top: 2.5rem;
  }

  .footer-inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    padding-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .footer-inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }

  .footer-tagline {
    color: var(--color-text-muted);
    margin: 0;
    font-size: 0.9rem;
  }

  .footer-block a {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .footer-messenger {
    font-weight: 600;
    color: var(--color-accent-dark) !important;
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .footer-bottom p {
    margin: 0;
  }
</style>
