---
export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button type="button" id="voice-call-btn" class={`btn voice-call-btn ${className}`.trim()}>
  <span aria-hidden="true">&#9742;</span> Talk With Us
</button>
<p id="voice-call-status" class="voice-call-status" hidden></p>

<script>
  import { RetellClient } from 'retell-client-js-sdk';

  const PUBLIC_KEY = 'public_key_923aacb3a06f223ce6c59';
  const AGENT_ID = 'agent_6decd4a3da3a67a3d34fb13007';

  // Lightweight per-browser abuse guard: cap web calls in a rolling window,
  // then send repeat visitors to Messenger instead of another call.
  const MAX_CALLS = 3;
  const WINDOW_MS = 24 * 60 * 60 * 1000;
  const STORE_KEY = 'tsw_voice_calls';
  const MESSENGER_URL = 'https://m.me/311951671232';

  const btn = document.getElementById('voice-call-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('voice-call-status') as HTMLParagraphElement;

  function callCount(): number {
    try {
      const raw = JSON.parse(localStorage.getItem(STORE_KEY) || '{}');
      if (!raw.windowStart || Date.now() - raw.windowStart > WINDOW_MS) return 0;
      return raw.count || 0;
    } catch {
      return 0;
    }
  }

  function recordCall() {
    try {
      const raw = JSON.parse(localStorage.getItem(STORE_KEY) || '{}');
      const fresh = !raw.windowStart || Date.now() - raw.windowStart > WINDOW_MS;
      localStorage.setItem(
        STORE_KEY,
        JSON.stringify({
          windowStart: fresh ? Date.now() : raw.windowStart,
          count: (fresh ? 0 : raw.count || 0) + 1,
        }),
      );
    } catch {
      /* private mode / storage blocked -- limit just won't persist, fine */
    }
  }

  function setStatus(text: string, show = true) {
    statusEl.textContent = text;
    statusEl.hidden = !show;
  }

  function resetButton() {
    btn.innerHTML = '<span aria-hidden="true">&#9742;</span> Talk With Us';
    btn.disabled = false;
  }

  function showLimitReached() {
    btn.innerHTML = 'Message Julie directly';
    btn.onclick = () => window.open(MESSENGER_URL, '_blank', 'noopener');
    setStatus("You've reached us a few times already -- for anything else, message Julie directly and she'll get right back to you.");
  }

  const client = new RetellClient({ key: PUBLIC_KEY });
  let call: ReturnType<typeof client.createWebCall> | null = null;

  async function startCall() {
    if (call && call.status !== 'ended') {
      await call.end();
      return;
    }

    if (callCount() >= MAX_CALLS) {
      showLimitReached();
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<span aria-hidden="true">&#9742;</span> Connecting...';
    setStatus('Connecting -- one moment...');
    recordCall();

    try {
      call = client.createWebCall({
        agent_id: AGENT_ID,
        hooks: {
          onStatus: (status: string) => {
            if (status === 'live') {
              btn.innerHTML = '<span aria-hidden="true">&#9742;</span> End Call';
              btn.disabled = false;
              setStatus("You're connected -- talk anytime, tap End Call when you're done.");
            }
          },
          onEnd: () => {
            if (callCount() >= MAX_CALLS) {
              showLimitReached();
              return;
            }
            resetButton();
            setStatus('Call ended. Thanks for chatting!');
            setTimeout(() => setStatus('', false), 4000);
          },
          onError: () => {
            resetButton();
            setStatus("Something went wrong connecting the call -- you're welcome to message us instead.");
          },
        },
      });
    } catch {
      resetButton();
      setStatus("Couldn't start the call -- you're welcome to message us instead.");
    }
  }

  btn.addEventListener('click', startCall);
</script>

<style>
  .voice-call-btn {
    font-family: inherit;
    white-space: nowrap;
  }

  .voice-call-status {
    flex-basis: 100%;
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: #fff;
    opacity: 0.9;
  }
</style>
