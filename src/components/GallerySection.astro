---
export interface Props {
  id: string;
  folder: string;
  images: { file: string; alt: string; folder?: string }[];
  eyebrow?: string;
  title?: string;
  bare?: boolean;
  compact?: boolean;
}

const { id, folder, images, eyebrow, title, bare = false, compact = false } = Astro.props;
const basePath = `/images/${folder}/`;

function imgSrc(img: { file: string; folder?: string }) {
  return img.folder ? `/images/${img.folder}/${img.file}` : basePath + img.file;
}
---

{images.length > 0 && (
  <section class:list={['gallery-section', { 'gallery-section-bare': bare }]} id={id}>
    <div class:list={[{ container: !bare }]}>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {title && <h2>{title}</h2>}
      <div class:list={['gallery-grid', { 'gallery-grid-compact': compact }]}>
        {images.map((img, i) => (
          <button
            type="button"
            class="gallery-thumb"
            data-full={imgSrc(img)}
            data-alt={img.alt}
            data-index={i}
          >
            <img src={imgSrc(img)} alt={img.alt} loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>

    <div class="lightbox" data-lightbox hidden>
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">&#10005;</button>
      <button type="button" class="lightbox-prev" data-lightbox-prev aria-label="Previous image">&#8249;</button>
      <img class="lightbox-img" data-lightbox-img src="" alt="" />
      <button type="button" class="lightbox-next" data-lightbox-next aria-label="Next image">&#8250;</button>
    </div>
  </section>
)}

<style>
  .gallery-section {
    padding: 2.5rem 0;
  }

  .gallery-section-bare {
    padding: 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.9rem;
    }
  }

  @media (min-width: 960px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-grid-compact {
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .gallery-grid-compact {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-thumb {
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .gallery-thumb:hover img {
    transform: scale(1.04);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(20, 16, 12, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 88vh;
    border-radius: 4px;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.5rem;
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox[hidden] {
    display: none;
  }
</style>

<script define:vars={{ sectionId: id }}>
  const section = document.getElementById(sectionId);
  if (section) {
    const thumbs = Array.from(section.querySelectorAll('.gallery-thumb'));
    const lightbox = section.querySelector('[data-lightbox]');
    const imgEl = section.querySelector('[data-lightbox-img]');
    let current = 0;

    function open(i) {
      current = i;
      const t = thumbs[i];
      imgEl.src = t.dataset.full;
      imgEl.alt = t.dataset.alt;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }

    function show(delta) {
      current = (current + delta + thumbs.length) % thumbs.length;
      open(current);
    }

    thumbs.forEach((t, i) => t.addEventListener('click', () => open(i)));
    section.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
    section.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(-1));
    section.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(-1);
      if (e.key === 'ArrowRight') show(1);
    });
  }
</script>
