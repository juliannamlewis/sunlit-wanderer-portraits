---
---

<div id="chat-widget">
  <button type="button" id="chat-toggle" aria-expanded="false" aria-controls="chat-panel">
    <span class="chat-toggle-icon" aria-hidden="true">&#9993;</span>
    <span class="visually-hidden">Chat with us</span>
  </button>

  <div id="chat-panel" hidden>
    <div class="chat-header">
      <span>Questions? Ask away</span>
      <button type="button" id="chat-close" aria-label="Close chat">&#10005;</button>
    </div>
    <div id="chat-messages" role="log" aria-live="polite">
      <div class="chat-bubble chat-bubble-bot">
        Hi! I'm here to help with questions about sessions, pricing, locations, or booking. Quick note — first name is all I need if we get to contact info, no last name necessary! What can I help with?
      </div>
    </div>
    <form id="chat-form">
      <input
        type="text"
        id="chat-input"
        placeholder="Type a question..."
        autocomplete="off"
        maxlength="1000"
      />
      <button type="submit" aria-label="Send">&#10148;</button>
    </form>
  </div>
</div>

<script>
  const toggle = document.getElementById('chat-toggle');
  const panel = document.getElementById('chat-panel');
  const closeBtn = document.getElementById('chat-close');
  const messagesEl = document.getElementById('chat-messages');
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input');

  let history = [];
  let sending = false;

  function open() {
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    input.focus();
  }

  function close() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', () => {
    if (panel.hidden) open();
    else close();
  });
  closeBtn.addEventListener('click', close);

  function addBubble(text, who) {
    const div = document.createElement('div');
    div.className = `chat-bubble chat-bubble-${who}`;
    div.textContent = text;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return div;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || sending) return;

    sending = true;
    input.value = '';
    addBubble(text, 'user');
    history.push({ role: 'user', content: text });

    const typingBubble = addBubble('...', 'bot');

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });
      const data = await res.json();
      typingBubble.textContent =
        data.reply || `Sorry, something went wrong. You can message us directly instead.`;
      history.push({ role: 'assistant', content: data.reply || '' });
    } catch {
      typingBubble.textContent = 'Sorry, something went wrong on my end. Try again in a moment?';
    } finally {
      sending = false;
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }
  });
</script>

<style>
  #chat-widget {
    position: fixed;
    right: 1.25rem;
    bottom: 1.5rem;
    z-index: 150;
  }

  @media (max-width: 720px) {
    #chat-widget {
      bottom: 5.5rem;
      right: 1rem;
    }
  }

  #chat-toggle {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #chat-toggle:hover {
    background: var(--color-accent-dark);
  }

  #chat-panel {
    position: absolute;
    bottom: 4rem;
    right: 0;
    width: min(340px, calc(100vw - 2rem));
    height: min(480px, 70vh);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  #chat-panel[hidden] {
    display: none;
  }

  .chat-header {
    background: var(--color-forest);
    color: #fff;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .chat-header button {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    font-size: 1rem;
    padding: 0.25rem;
  }

  #chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .chat-bubble {
    max-width: 85%;
    padding: 0.55rem 0.8rem;
    border-radius: 0.9rem;
    font-size: 0.88rem;
    line-height: 1.4;
    white-space: pre-wrap;
  }

  .chat-bubble-bot {
    align-self: flex-start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-bottom-left-radius: 0.2rem;
  }

  .chat-bubble-user {
    align-self: flex-end;
    background: var(--color-accent);
    color: #fff;
    border-bottom-right-radius: 0.2rem;
  }

  #chat-form {
    display: flex;
    border-top: 1px solid var(--color-border);
    padding: 0.6rem;
    gap: 0.5rem;
  }

  #chat-input {
    flex: 1;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-size: 0.88rem;
    font-family: var(--font-body);
    background: var(--color-surface);
    color: var(--color-text);
  }

  #chat-input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  #chat-form button {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    flex-shrink: 0;
  }

  #chat-form button:hover {
    background: var(--color-accent-dark);
  }
</style>
