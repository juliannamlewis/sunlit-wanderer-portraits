---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import VoiceCallButton from '../components/VoiceCallButton.astro';
import { ASSISTANTS_LIVE } from '../lib/flags';
import GallerySection from '../components/GallerySection.astro';
import SessionPlanner from '../components/SessionPlanner.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import { site, pricing, sessionLinks, thumb } from '../lib/content';
import { loadCopy } from '../lib/markdown';
import homeGallery from '../content/galleries/home.json';
import generalFaq from '../content/faq/general.json';
import specials from '../content/specials.json';

const about = loadCopy('about');
const aboutTeaser = about.html.match(/<p>([\s\S]*?)<\/p>/)?.[1] ?? '';

// Hero slideshow, in order. Landscape originals only — portrait crops badly
// at desktop widths. The first slide is the one shown without JavaScript.
const heroSlides = [
  { src: '/images/families/families-02-silhouette-sunset.jpg', position: 'center 30%' },
  { src: '/images/couples/couples-03-forehead-touch-backlit.jpg', position: 'center 40%' },
  { src: '/images/home/home-06-multigenerational-walk-wooded.jpg', position: 'center 45%' },
  { src: '/images/home/home-12-girl-tall-grass.jpg', position: 'center 40%' },
];

const howItWorks = [
  'Choose your session',
  'See Availability & Book through ShootProof',
  'Complete a short questionnaire',
  'Planning & communication as needed',
  'Your session',
  `Finished gallery within ${site.delivery.turnaround}`,
];
---

<BaseLayout title={site.site.name} headerVariant="full">
  <section class="hero" data-hero>
    <div class="hero-slides" aria-hidden="true">
      {heroSlides.map((slide, i) => (
        <div
          class:list={['hero-slide', { 'is-active': i === 0 }]}
          style={`background-image: url('${thumb(slide.src, 'lg')}'); background-position: ${slide.position};`}
        />
      ))}
    </div>
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="container hero-inner">
      <span class="eyebrow hero-eyebrow">{site.site.serviceArea}</span>
      <h1 class="hero-heading">{site.site.heroHeadline || site.site.tagline}</h1>
      <p class="hero-price">Sessions from {pricing.tiers[0].priceDisplay}</p>
      <div class="hero-actions">
        <a href="#home-gallery" class="btn btn-outline hero-outline-btn">Portfolio Gallery</a>
        <BookingButton />
        {ASSISTANTS_LIVE && <VoiceCallButton />}
      </div>
      <p class="hero-quiet">
        Questions? <a href={site.contact.messenger} target="_blank" rel="noopener">{site.contact.messengerLabel}</a>
        {site.contact.phoneDisplay && (
          <> or call/text <a href={site.contact.phoneTel}>{site.contact.phoneDisplay}</a></>
        )}
      </p>
    </div>

    {heroSlides.length > 1 && (
      <div class="hero-dots" aria-hidden="true">
        {heroSlides.map((_, i) => <span class:list={['hero-dot', { 'is-active': i === 0 }]} />)}
      </div>
    )}
  </section>

  <div class="notice-bar">
    <div class="container notice-inner">
      {specials.active && (
        <a class="notice-special" href="/specials">
          <span class="specials-tag">&#10022; This Month</span>
          <span>{specials.bannerText} &rarr;</span>
        </a>
      )}
      <a class="notice-booked" href="/prepare">Already booked? Prepare for your session &rarr;</a>
    </div>
  </div>

  <section class="section session-tiles">
    <div class="container">
      <span class="eyebrow">Sessions</span>
      <div class="tile-grid">
        {sessionLinks.map((s) => (
          <a class="tile" href={s.href}>
            {s.cover ? (
              <img src={thumb(s.cover)} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="tile-blank" aria-hidden="true"></span>
            )}
            <span class="tile-text">
              <span class="tile-label">{s.label}</span>
              <span class="tile-cta">{s.cover ? 'See gallery' : 'Learn more'}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <GallerySection
    id="home-gallery"
    folder="home"
    images={homeGallery.images}
    eyebrow="Portfolio"
    title="A little of everything"
  />

  <div class="section-alt">
    <SessionPlanner />
  </div>

  <section class="section how-it-works">
    <div class="container">
      <h2>How It Works</h2>
      <ol class="steps-list">
        {howItWorks.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <ReviewsSection placement="home" variant="slider" />

  <FaqSection title={generalFaq.title} questions={generalFaq.questions} />

  {aboutTeaser && (
    <section class:list={['section-alt about-teaser', { 'has-photo': about.frontmatter.photo }]}>
      <div class="container about-teaser-inner">
        {about.frontmatter.photo && (
          <img
            class="about-teaser-photo"
            src={thumb(about.frontmatter.photo)}
            alt={about.frontmatter.photoAlt}
            style={about.frontmatter.photoPosition ? `object-position: ${about.frontmatter.photoPosition}` : undefined}
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="about-teaser-text">
          <span class="eyebrow">Nice to meet you</span>
          <h2>Hi, I'm Julie</h2>
          <p set:html={aboutTeaser} />
          <a href="/about" class="btn btn-outline btn-small">More about me</a>
        </div>
      </div>
    </section>
  )}

  <section class="closing-cta">
    <div class="container closing-inner">
      <h2>Ready when you are</h2>
      <p>{site.site.serviceRadiusNote}</p>
      <BookingButton />
      {site.contact.phoneDisplay && (
        <p class="closing-phone">
          Rather talk it through? Call or text <a href={site.contact.phoneTel}>{site.contact.phoneDisplay}</a>
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Crossfade the hero photographs. Skipped entirely for reduced-motion users,
  // who keep the first slide.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const slides = hero ? [...hero.querySelectorAll<HTMLElement>('.hero-slide')] : [];
  const dots = hero ? [...hero.querySelectorAll<HTMLElement>('.hero-dot')] : [];

  if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let current = 0;
    setInterval(() => {
      if (document.hidden) return;
      slides[current].classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
      dots[current]?.classList.add('is-active');
    }, 6000);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 52rem);
    display: flex;
    align-items: flex-end;
    padding: 6rem 0 4.5rem;
    overflow: hidden;
    background: var(--color-forest);
  }

  .hero-slides,
  .hero-slide,
  .hero-shade {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    background-size: cover;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 1.6s ease, transform 7.5s ease-out;
  }

  .hero-slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .hero-shade {
    background:
      linear-gradient(to top, rgba(26, 34, 23, 0.85) 0%, rgba(26, 34, 23, 0.35) 45%, rgba(26, 34, 23, 0.1) 100%),
      linear-gradient(100deg, rgba(26, 34, 23, 0.55) 0%, rgba(26, 34, 23, 0) 60%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-inner > * {
    max-width: 40rem;
  }

  .hero-eyebrow {
    color: var(--color-cream);
    letter-spacing: 0.22em;
  }

  .hero-heading {
    color: #fff;
    font-size: clamp(2.1rem, 4.6vw, 3.25rem);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 0.6rem;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .hero-price {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--color-cream);
    margin-bottom: 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  @media (max-width: 560px) {
    .hero-actions > :global(*) {
      flex: 1 1 100%;
    }
  }

  .hero-outline-btn {
    color: #fff;
    border-color: #fff;
  }

  .hero-outline-btn:hover {
    background: #fff;
    color: var(--color-forest);
    border-color: #fff;
  }

  .hero-quiet {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-cream);
  }

  .hero-quiet a {
    color: #fff;
    white-space: nowrap;
  }

  .hero-dots {
    position: absolute;
    z-index: 1;
    right: 1.5rem;
    bottom: 1.75rem;
    display: flex;
    gap: 0.45rem;
  }

  .hero-dot {
    width: 1.6rem;
    height: 2px;
    background: rgba(255, 255, 255, 0.4);
    transition: background 0.4s ease;
  }

  .hero-dot.is-active {
    background: #fff;
  }

  @media (max-width: 560px) {
    .hero {
      min-height: 0;
      padding-top: 9rem;
    }

    .hero-dots {
      display: none;
    }
  }

  .notice-bar {
    background: var(--color-soil);
    color: var(--color-cream);
    font-size: 0.92rem;
  }

  .notice-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }

  .notice-bar a {
    color: inherit;
    text-decoration: none;
  }

  .notice-bar a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .notice-special {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    font-weight: 600;
    color: #fff !important;
  }

  .specials-tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .notice-booked {
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .notice-inner {
      justify-content: center;
      text-align: center;
    }

    .notice-booked {
      margin-left: 0;
    }
  }

  .session-tiles {
    padding-bottom: 1rem;
  }

  .tile-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 0.75rem;
  }

  @media (min-width: 860px) {
    .tile-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }

  .tile {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-forest);
    color: #fff;
    text-decoration: none;
  }

  .tile img,
  .tile-blank {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .tile-blank {
    background:
      radial-gradient(circle at 30% 25%, rgba(182, 139, 69, 0.55), transparent 60%),
      linear-gradient(160deg, var(--color-olive), var(--color-forest));
  }

  .tile:hover img {
    transform: scale(1.05);
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26, 34, 23, 0.8), rgba(26, 34, 23, 0) 55%);
  }

  .tile-text {
    position: absolute;
    z-index: 1;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.35rem;
  }

  .tile-label {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .tile-cta {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-cream);
  }

  .tile-cta::after {
    content: ' →';
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .tile:hover .tile-cta::after {
    transform: translateX(4px);
  }

  .steps-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .steps-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem 2rem;
    }
  }

  .steps-list li {
    counter-increment: step;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
    font-weight: 500;
  }

  .steps-list li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-accent);
  }

  .about-teaser {
    padding: 4rem 0;
    text-align: center;
  }

  .about-teaser-inner {
    max-width: 38rem;
  }

  .about-teaser h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
  }

  .about-teaser p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  /* With a photo: picture beside the text, left-aligned like a magazine intro */
  .about-teaser.has-photo .about-teaser-inner {
    max-width: 58rem;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .about-teaser-photo {
    width: 100%;
    max-width: 20rem;
    margin: 0 auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius);
    box-shadow: 0 18px 40px rgba(26, 34, 23, 0.22);
  }

  @media (min-width: 760px) {
    .about-teaser.has-photo {
      text-align: left;
    }

    .about-teaser.has-photo .about-teaser-inner {
      grid-template-columns: minmax(0, 20rem) 1fr;
      gap: 3.5rem;
    }
  }

  .closing-cta {
    padding: 4.5rem 0;
    text-align: center;
    background: var(--color-forest);
    color: var(--color-cream);
  }

  .closing-cta h2 {
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
  }

  .closing-inner {
    max-width: 34rem;
    margin: 0 auto;
  }

  .closing-phone {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
  }

  .closing-phone a {
    color: #fff;
    white-space: nowrap;
  }
</style>
