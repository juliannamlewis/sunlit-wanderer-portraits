---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import GallerySection from '../components/GallerySection.astro';
import PricingSection from '../components/PricingSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import { site, pricing, navLinks } from '../lib/content';
import { loadCopy } from '../lib/markdown';
import homeGallery from '../content/galleries/home.json';
import generalFaq from '../content/faq/general.json';

const categoryLinks = navLinks.slice(0, 4);
const about = loadCopy('about');
const aboutTeaser = about.html.match(/<p>([\s\S]*?)<\/p>/)?.[1] ?? '';

const howItWorks = [
  'Choose your session',
  'See Availability & Book through ShootProof',
  'Complete a short questionnaire',
  'Planning & communication as needed',
  'Your session',
  `Finished gallery within ${site.delivery.turnaround}`,
];
---

<BaseLayout title={site.site.name} headerVariant="full">
  <section class="hero" style="background-image: linear-gradient(100deg, rgba(26,34,23,0.82) 0%, rgba(26,34,23,0.55) 45%, rgba(26,34,23,0.15) 75%), url('/images/families/families-02-silhouette-sunset.jpg');">
    <div class="container hero-inner">
      <span class="eyebrow hero-eyebrow">{site.site.serviceArea}</span>
      <h1 class="hero-heading">{site.site.tagline}</h1>
      <p class="hero-price">Sessions from {pricing.tiers[0].priceDisplay}</p>
      <div class="hero-actions">
        <a href="#home-gallery" class="btn btn-outline hero-outline-btn">Portfolio Gallery</a>
        <BookingButton />
      </div>
      <p class="hero-quiet">
        Questions? <a href={site.contact.messenger} target="_blank" rel="noopener">{site.contact.messengerLabel}</a>
      </p>
    </div>
  </section>

  <a class="already-booked" href="/prepare">
    Already booked? Prepare for your session &rarr;
  </a>

  <GallerySection
    id="home-gallery"
    folder="home"
    images={homeGallery.images}
    eyebrow="Portfolio"
    title="A little of everything"
  />

  <section class="section plan-your-session">
    <div class="container">
      <h2>Plan Your Session</h2>
      <div class="steps-grid">
        <a class="step-card" href="#categories">
          <span class="step-number">01</span>
          <span class="step-label">Choose your session type</span>
        </a>
        <a class="step-card" href="#pricing">
          <span class="step-number">02</span>
          <span class="step-label">Choose your session length</span>
        </a>
        <a class="step-card" href="#find-your-setting">
          <span class="step-number">03</span>
          <span class="step-label">Find your setting</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section categories" id="categories">
    <div class="container">
      <h2>Choose your session type</h2>
      <div class="category-grid">
        {categoryLinks.map((link) => (
          <a class="category-card" href={link.href}>
            <span>{link.label}</span>
            <span class="category-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="section-alt">
    <PricingSection />
  </div>

  <section class="section find-your-setting" id="find-your-setting">
    <div class="container">
      <h2>Find Your Setting</h2>
      <p>
        Gardens, rustic trails, city streets or somewhere meaningful to you. See what
        some of my favorite {site.site.serviceArea} locations actually look like before
        choosing.
      </p>
      <div class="find-your-setting-actions">
        <a href="/locations" class="btn">Explore Locations</a>
      </div>
      <p class="fine-print">
        Already have somewhere special in mind?
        <a href={site.contact.messenger} target="_blank" rel="noopener">Tell me about it.</a>
      </p>
    </div>
  </section>

  <section class="section-alt how-it-works">
    <div class="container">
      <h2>How It Works</h2>
      <ol class="steps-list">
        {howItWorks.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <ReviewsSection placement="home" />

  <FaqSection title={generalFaq.title} questions={generalFaq.questions} />

  {aboutTeaser && (
    <section class="section-alt about-teaser">
      <div class="container about-teaser-inner">
        <h2>Hi, I'm Julie</h2>
        <p set:html={aboutTeaser} />
        <a href="/about" class="btn btn-outline btn-small">More about me</a>
      </div>
    </section>
  )}

  <section class="section closing-cta">
    <div class="container closing-inner">
      <h2>Ready when you are</h2>
      <p>{site.site.serviceRadiusNote}</p>
      <BookingButton />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0 4rem;
    background-size: cover;
    background-position: center 30%;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: 42rem;
  }

  .hero-eyebrow {
    color: var(--color-cream);
  }

  .hero-heading {
    color: #fff;
    margin-bottom: 0.5rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .hero-price {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-cream);
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero-outline-btn {
    color: #fff;
    border-color: #fff;
  }

  .hero-outline-btn:hover {
    background: #fff;
    color: var(--color-forest);
    border-color: #fff;
  }

  .hero-quiet {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-cream);
  }

  .hero-quiet a {
    color: #fff;
  }

  .already-booked {
    display: block;
    text-align: center;
    padding: 0.9rem 1rem;
    background: var(--color-soil);
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .already-booked:hover {
    background: var(--color-forest);
  }

  .steps-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 720px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step-card {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .step-label {
    font-weight: 600;
  }

  .category-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .category-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.4rem 1.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    transition: border-color 0.15s ease, transform 0.1s ease;
  }

  .category-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .category-arrow {
    color: var(--color-accent);
  }

  .find-your-setting p {
    max-width: 42rem;
  }

  .find-your-setting-actions {
    margin: 1.25rem 0;
  }

  .fine-print {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .steps-list {
    margin: 1.5rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.6rem;
    max-width: 32rem;
  }

  .about-teaser-inner {
    max-width: 34rem;
  }

  .about-teaser p {
    color: var(--color-text-muted);
  }

  .closing-cta {
    text-align: center;
  }

  .closing-inner {
    max-width: 34rem;
    margin: 0 auto;
  }
</style>
