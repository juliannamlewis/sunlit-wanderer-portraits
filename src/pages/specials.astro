---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import { site } from '../lib/content';
import specials from '../content/specials.json';

// While no special is switched on in specials.json, the old flyer and its
// booking link stay hidden — this page stays reachable for old QR codes and
// links, but points people to regular sessions instead.
---

<BaseLayout
  title="Specials"
  description="Limited-time mini session specials from The Sunlit Wanderer — portrait photography in Dayton, Ohio. New specials posted regularly."
  noindex={!specials.active}
>
  <section class="section">
    {specials.active ? (
      <div class="container specials-container">
        <h1 class="visually-hidden">Current Specials</h1>
        <img
          src="/images/specials/current-special.jpg"
          alt="Current photography special from The Sunlit Wanderer — see pricing, dates, and details in the graphic above"
          class="specials-flyer"
          width="1200"
          height="628"
        />
        <div class="specials-cta">
          <BookingButton tierKey="current-special" label="Book Now" />
        </div>
      </div>
    ) : (
      <div class="container specials-container specials-off">
        <h1>Specials</h1>
        <p>There isn't a special running right now, but regular sessions are open year-round.</p>
        <div class="specials-off-actions">
          <a href="/#plan" class="btn">Plan Your Session</a>
          <a href={site.contact.messenger} target="_blank" rel="noopener" class="btn btn-outline">{site.contact.messengerLabel}</a>
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .specials-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 900px;
  }

  .specials-flyer {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  }

  .specials-cta :global(.btn) {
    font-size: 1.1rem;
    padding: 0.9rem 2.5rem;
  }

  .specials-off {
    text-align: center;
    max-width: 36rem;
    padding: 2rem 1.25rem;
    gap: 0.5rem;
  }

  .specials-off-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>
