---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyProse from '../components/CopyProse.astro';
import GallerySection from '../components/GallerySection.astro';
import PricingSection from '../components/PricingSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import PinterestBoards from '../components/PinterestBoards.astro';
import { loadCopy } from '../lib/markdown';
import gallery from '../content/galleries/maternity.json';
import faq from '../content/faq/maternity.json';

const { frontmatter, html } = loadCopy('maternity');
---

<BaseLayout title={frontmatter.title} description={frontmatter.metaDescription}>
  <section class="section page-intro">
    <div class="container">
      <CopyProse html={html} />
    </div>
  </section>

  <GallerySection
    id="maternity-gallery"
    folder="maternity"
    images={gallery.images}
    eyebrow="Gallery"
    title="Maternity"
  />

  {gallery.images.length === 0 && (gallery.emptyGalleryNote || gallery.emptyGalleryCallout) && (
    <section class="section empty-gallery-note">
      <div class="container">
        {gallery.emptyGalleryNote && <p>{gallery.emptyGalleryNote}</p>}
        {gallery.emptyGalleryCallout && <p>{gallery.emptyGalleryCallout}</p>}
      </div>
    </section>
  )}

  <div class="section-alt">
    <PricingSection category="maternity" />
  </div>

  <ReviewsSection placement="maternity" />

  <FaqSection title={faq.title} questions={faq.questions} />

  <PinterestBoards category="maternity" />
</BaseLayout>

<style>
  .empty-gallery-note {
    padding-top: 0;
  }

  .empty-gallery-note .container {
    max-width: 42rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
  }

  .empty-gallery-note p {
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .empty-gallery-note p:last-child {
    margin-bottom: 0;
  }
</style>
